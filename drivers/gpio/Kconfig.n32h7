config GPIO_N32H7
	bool "N32H7 GPIO driver"
	default y
	depends on SOC_SERIES_N32H78X
	depends on CLOCK_CONTROL
	help
	  Enable the N32H7 GPIO driver. Interrupt/EXTI support is deferred until
	  the interrupt routing has been validated on hardware.
