source "share/sysbuild/Kconfig"

config N32H7_CM4_IMAGE
	bool "Build the Cortex-M4 image alongside the Cortex-M7 image"
	depends on BOARD_N32H787XIB7_STB_N32H787_CM7
	default y
	help
	  Build the Cortex-M4 cluster image from the same application source.
	  The Cortex-M4 image is build-only: it shares the xSPI flash with the
	  Cortex-M7 image and is programmed by merging both HEX files and
	  loading them through the CM7 debug port.
